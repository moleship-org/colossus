# Podman Quadlet unit for Colossus - rootless (no sudo) variant.
#
# Unlike colossus-rootful.container, which runs as a system service owned
# by root, this variant runs entirely under a regular user's own systemd
# instance and rootless Podman - no sudo is needed to install, start, or
# manage it.
#
# For Colossus to keep running after you log out, and to start automatically
# on boot, enable lingering for the user. This is the only step in this
# whole setup that needs root, since it's a system-wide login setting:
#   sudo loginctl enable-linger "$USER"
#
# See scripts/quick-setup.sh and scripts/setup/*.sh for an automated install.

[Unit]
Description=Colossus - Web UI for Moleship (rootless)
Documentation=https://github.com/moleship-org/colossus

[Container]
ContainerName=colossus
Image=ghcr.io/moleship-org/colossus:latest
AutoUpdate=registry

# This only works if Moleship is *also* reachable via localhost - either
# running directly on the host, or itself using Network=host.
Network=host

# Override NUXT_API_BASE as needed
Environment=NUXT_API_BASE=http://localhost:5000/api/v1
EnvironmentFile=%h/.config/colossus/colossus.env

NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
