# Podman Quadlet unit for Colossus.
#
# See scripts/quick-setup.sh and scripts/setup/*.sh for an automated install.

[Unit]
Description=Colossus - Web UI for Moleship
Documentation=https://github.com/moleship-org/colossus
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=colossus
Image=ghcr.io/moleship-org/colossus:latest
AutoUpdate=registry

# This only works if Moleship is *also* reachable via localhost - either
# running directly on the host, or itself using Network=host.
Network=host

# Override NUXT_API_BASE as needed
Environment=NUXT_API_BASE=http://localhost:5000/api/v1
EnvironmentFile=/etc/colossus/colossus.env

NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
